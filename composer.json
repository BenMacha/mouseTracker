{
    "name": "benmacha/mousetracker",
    "description": "Self-hosted mouse, click and scroll tracker for Symfony. Mouseflow-style heatmaps and session replay.",
    "type": "symfony-bundle",
    "keywords": [
        "symfony",
        "symfony-bundle",
        "mouse",
        "tracker",
        "heatmap",
        "click-tracking",
        "scroll-tracking",
        "session-replay",
        "session-recording",
        "analytics",
        "user-behavior",
        "ux",
        "self-hosted",
        "mouseflow",
        "hotjar",
        "gdpr",
        "privacy"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Ali Ben Macha",
            "email": "contact@benmacha.tn",
            "homepage": "https://benmacha.tn"
        }
    ],
    "require": {
        "php": ">=8.1",
        "symfony/framework-bundle": "^5.4|^6.4|^7.0",
        "symfony/http-foundation": "^5.4|^6.4|^7.0",
        "symfony/http-kernel": "^5.4|^6.4|^7.0",
        "symfony/dependency-injection": "^5.4|^6.4|^7.0",
        "symfony/config": "^5.4|^6.4|^7.0",
        "symfony/routing": "^5.4|^6.4|^7.0",
        "symfony/yaml": "^5.4|^6.4|^7.0",
        "doctrine/orm": "^2.14|^3.0",
        "doctrine/doctrine-bundle": "^2.10",
        "doctrine/persistence": "^3.0|^4.0",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.65",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^9.6|^10.5|^11.0",
        "symfony/browser-kit": "^5.4|^6.4|^7.0",
        "symfony/css-selector": "^5.4|^6.4|^7.0",
        "symfony/dom-crawler": "^5.4|^6.4|^7.0",
        "symfony/phpunit-bridge": "^5.4|^6.4|^7.0",
        "symfony/twig-bundle": "^5.4|^6.4|^7.0",
        "symfony/var-exporter": "^6.4|^7.0"
    },
    "autoload": {
        "psr-4": {
            "benmacha\\mousetracker\\": ""
        },
        "exclude-from-classmap": ["/Resources/", "/tests/"]
    },
    "autoload-dev": {
        "psr-4": {
            "benmacha\\mousetracker\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/runtime": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
